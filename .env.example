# ─────────────────────────────────────────────────────────────────────────────
# Tender Ambiguity Detector — environment configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; never commit it.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Backend selection ──────────────────────────────────────────────────────
# 0 = use AI Studio API key path (simpler; bills against the linked card,
#     does NOT consume GCP $300 trial credits — see README "Cost discipline").
# 1 = use Vertex AI path (credit-eligible; requires a service account JSON
#     pointed to by GOOGLE_APPLICATION_CREDENTIALS).
GEMINI_USE_VERTEX=0

# ─── AI Studio mode (when GEMINI_USE_VERTEX=0) ──────────────────────────────
# Required in this mode. Get a key at:
#   https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ─── Fallback chain (optional) ──────────────────────────────────────────────
# When the primary GEMINI_API_KEY hits a quota / rate limit, the client
# transparently fails over to these in order:
#   1. GEMINI_API_KEY      (primary)
#   2. GROQ_API_KEY        (Llama 3.3 70B for LLM calls; Groq has no embed
#                           endpoint so embeddings still need Gemini)
#   3. GEMINI_API_KEY_OLD  (a second Gemini key, e.g. on a paid project)
# Set one or both to enable fallback. If neither is set, only the primary
# is used.
GROQ_API_KEY=
GEMINI_API_KEY_OLD=

# ─── Vertex AI mode (when GEMINI_USE_VERTEX=1) ──────────────────────────────
# Required in this mode. The GCP project that owns the Gemini API quota.
GCP_PROJECT_ID=your-gcp-project-id
# Vertex AI region. us-central1 is the most-broadly supported.
GCP_LOCATION=us-central1
# Path to a Vertex-AI-User service account JSON key file. Create at:
#   https://console.cloud.google.com/iam-admin/serviceaccounts
GOOGLE_APPLICATION_CREDENTIALS=./gcp-vertex-sa.json

# ─── Default models (work for both backends) ────────────────────────────────
# Override per-call from Python if needed.
GEMINI_MODEL_FLASH=gemini-2.5-flash
GEMINI_MODEL_PRO=gemini-2.5-pro
GEMINI_MODEL_EMBEDDING=gemini-embedding-001

# ─── Cache + rate-limit knobs ───────────────────────────────────────────────
# 1 = disable the on-disk LLM response cache (every call hits the API).
# Default: cache enabled. Re-runs are free with caching.
GEMINI_CACHE_DISABLED=0

# Optional. Path to the cache directory.
# Default: <project_root>/.cache/llm/
GEMINI_CACHE_DIR=

# Embedding batch size. Paid tier handles 50 cleanly. Drop to 5–10 if you
# see 429 RESOURCE_EXHAUSTED on free-tier quota.
GEMINI_EMBED_BATCH_SIZE=50

# Sleep between embedding batches (seconds). Useful to throttle on free tier.
GEMINI_EMBED_SLEEP_SECONDS=0.0

# ─── Safety cap (advisory; client-side only) ────────────────────────────────
# Daily USD cap reported alongside aggregate stats. Server-side enforcement
# also recommended via Google Cloud Console quota limits.
GEMINI_DAILY_USD_CAP=10.0
